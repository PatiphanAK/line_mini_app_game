# Alibaba Cloud Model Studio (DashScope) API key
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
# International endpoint. China mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
PORT=3000
# Optional: LIFF app ID (LINE Developers console). Endpoint URL = https://<your-host>/play
# When set, players opened in LINE join with their LINE photo and display name.
LIFF_ID=
